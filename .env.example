# Copier en .env et adapter.

# Avec Steam (voir README). COMPOSE_FILE remplace la détection automatique :
# ajouter :docker-compose.override.yml à la fin si ce fichier existe.
#COMPOSE_FILE=docker-compose.yml:docker-compose.steam.yml

# Port de la page (TCP) et du flux (UDP), identique dans le conteneur
KYBER_PORT=8090
# Taille de l'écran virtuel
SCREEN_RESOLUTION=1920x1080
# Encodeur vidéo : x264 (processeur) ; vaapi est expérimental dans Kyber
KYBER_ENCODER=x264
# Disposition du clavier dans le bureau (variante "mac" pour un clavier Apple)
KEYBOARD_LAYOUT=fr
KEYBOARD_VARIANT=
# Langue du bureau (au build) et fuseau horaire
LOCALE=fr_FR.UTF-8
TZ=Europe/Paris
# Cœurs maximum pour le conteneur
CPUS=4

# Noms et adresses couverts par le certificat HTTPS auto-signé, séparés par des
# virgules, ex. IP:192.168.1.10,DNS:bureau.example.com
KYBER_TLS_SAN=IP:127.0.0.1

# --- Connexion par identifiants (par défaut) ---
# Kyber ne limite pas les essais : mot de passe long et aléatoire,
# ex. openssl rand -base64 24
KYBER_BASIC_AUTH=true
KYBER_USER=
KYBER_PASSWORD=

# --- Connexion OIDC (facultative, voir README) ---
# Émetteur et client_id de l'application OIDC ; vide = désactivée
KYBER_OIDC_ISSUER=
KYBER_OIDC_CLIENT_ID=
# Adresses mail autorisées, séparées par des virgules
KYBER_OIDC_ALLOWED_EMAILS=

# --- Jetons signés JWT, pour le client natif (facultatif, voir README) ---
# Chemin, dans le conteneur, d'une clé publique RSA (RS256), par exemple
# /home/kyber/.config/kyber/jwt-public.pem (dossier data/home de l'hôte)
KYBER_JWT_PUBLIC_KEY_FILE=

# --- Steam (docker-compose.steam.yml) ---
# Groupes de /dev/dri/card0 et /dev/dri/renderD128 sur l'hôte :
#   getent group video render
VIDEO_GID=44
RENDER_GID=992
# Dossier de l'hôte pour les jeux, à ajouter dans Steam > Paramètres > Stockage
STEAM_LIBRARY=./data/steam-library
